{:paths ["src" "resources"]

 ;; The MLT document core (mlt.*) is portable (JVM / cljw / cljrs):
 ;; clojure.core and clojure.string only, no reader conditionals.
 ;; hive-addon is the host-neutral IAddon contract for the addon wiring only;
 ;; the portable namespaces never require it.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.hive-agi/hive-addon {:mvn/version "1.0.14"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps  {nrepl/nrepl {:mvn/version "1.7.0"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; clojure -M:test — kaocha, configured by tests.edn
  :test {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "kaocha.runner"]}

  ;; Build + Clojars deploy: clojure -T:build jar | clojure -T:build deploy
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.22"}}
          :ns-default hive-build.api}}}
