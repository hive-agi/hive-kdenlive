{:paths ["src" "resources"]

 ;; The MLT document core is portable (JVM / cljw / cljrs): clojure.core and
 ;; clojure.string only, no reader conditionals. Keep :deps a leaf — hosts and
 ;; transports (melt render, Kdenlive HTTP) join as aliases or addon wiring.
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps  {nrepl/nrepl {:mvn/version "1.7.0"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; clojure -M:test — kaocha, configured by tests.edn
  :test {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}
         :main-opts ["-m" "kaocha.runner"]}

  ;; Build + Clojars deploy: clojure -T:build jar | clojure -T:build deploy
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.15"}}
          :ns-default hive-build.api}}}
